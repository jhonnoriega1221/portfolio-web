---
import { Image } from "astro:assets";
import typing from "../assets/avatar/hero_1.png";
import surprised from "../assets/avatar/hero_2.png";
import waving from "../assets/avatar/hero_3.png";

interface props {
  messages?: string[];
  class?: string;
}

const {
  messages = ["¡Hola!", "Bienvenido a mi portfolio!", "¡Soy de colombia!"],
  class: className = "",
} = Astro.props;

const frame = "absolute inset-0 size-full origin-bottom object-cover opacity-0";
---

<div
  data-avatar-greeting
  data-state="typing"
  data-messages={JSON.stringify(messages)}
  class:list={["group/avatar relative", className]}
>
  <div
    class="shadow-base absolute inset-0 overflow-hidden border-6 border-black bg-primary"
  >
    <div class="pointer-events-none absolute inset-0 overflow-hidden flex justify-center items-center">
      <div class="absolute xl:size-220 lg:size-150 halftone bg-primary brightness-90"></div>
    </div>
    <Image
      src={typing}
      alt=""
      loading="eager"
      class:list={[frame, "group-data-[state=typing]/avatar:opacity-100"]}
    />
    <Image
      src={surprised}
      decoding="sync"
      alt=""
      loading="eager"
      class:list={[
        frame,
        "group-data-[state=surprised]/avatar:opacity-100 motion-safe:group-data-[state=surprised]/avatar:animate-squish",
      ]}
    />
    <Image
      src={waving}
      decoding="sync"
      alt=""
      loading="eager"
      class:list={[
        frame,
        "group-data-[state=waving]/avatar:opacity-100 motion-safe:group-data-[state=waving]/avatar:animate-squish",
      ]}
    />
  </div>

  <div
    data-particles
    aria-hidden
    class="pointer-events-none absolute bottom-[40%] left-[30%] size-0"
  >
  </div>

  <span
    aria-hidden="true"
    class="absolute top-[12%] left-1/2 -translate-x-1/2 scale-0 text-4xl font-black text-secondary
           [text-shadow:2px_2px_0_#000,-2px_-2px_0_#000,2px_-2px_0_#000,-2px_2px_0_#000]
           transition-transform duration-200
           group-data-[state=surprised]/avatar:scale-100"
  >
    !
  </span>

  <div
    data-bubble
    data-visible="false"
    aria-live="off"
    class="absolute bottom-[80%] right-[50%] origin-bottom-right scale-0 rounded-full border-2 border-black
         bg-white px-3 py-1.5 text-xs font-bold opacity-0 shadow-sm transition-transform duration-300
         data-[visible=true]:scale-100 data-[visible=true]:opacity-100"
  >
    <span class="grid">
      <span
        data-bubble-ghost
        aria-hidden="true"
        class="invisible col-start-1 row-start-1 xl:text-2xl md:text-xl"></span>
      <span
        data-bubble-text
        class="col-start-1 row-start-1 xl:text-2xl md:text-xl"></span>
    </span>
    <svg
      aria-hidden="true"
      viewBox="0 0 40 40"
      class="pointer-events-none absolute top-full right-2 h-auto w-8 overflow-visible"
    >
      <path
        d="M4 0 C6 16 20 28 38 34 C28 26 18 14 16 0"
        fill="white"
        stroke="black"
        stroke-width="2"
        stroke-linejoin="round"
        vector-effect="non-scaling-stroke"></path>
    </svg>
  </div>
</div>

<script>
  const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

  async function init(root: HTMLElement) {
    const messages: string[] = JSON.parse(root.dataset.messages ?? "[]");
    const bubble = root.querySelector<HTMLElement>("[data-bubble");
    const bubbleText = root.querySelector<HTMLElement>("[data-bubble-text");
    const particles = root.querySelector<HTMLElement>("[data-particles");
    const bubbleGhost = root.querySelector<HTMLElement>("[data-bubble-ghost]")!;

    const setState = (s: "typing" | "surprised" | "waving") =>
      (root.dataset.state = s);
    const showBubble = (v: boolean) => (bubble!.dataset.visible = String(v));

    if (matchMedia("(prefers-reduced-motion)").matches) {
      setState("waving");
      bubbleGhost.textContent = messages[0] ?? "";
      bubbleText!.textContent = messages[0] ?? "";
      showBubble(true);
      return;
    }

    function spawnTap() {
      const el = document.createElement("span");
      el.textContent = "tap";
      el.className = "animate-tap absolute text-sm font-black text-black";
      el.style.setProperty("--x", `${(Math.random() - 0.5) * 60}px `);
      el.style.left = `${(Math.random() - 0.5) * 0.5}px`;
      particles!.appendChild(el);
      el.addEventListener("animationend", () => el.remove());
    }

    async function typeText(text: string) {
      bubbleGhost.textContent = text;
      bubble!.setAttribute("aria-label", text);
      bubbleText!.textContent = "";

      for (let i = 1; i <= text.length; i++) {
        bubbleText!.textContent = text.slice(0, i);
        // Pausa en los signos de puntuación
        const last = text[i - 1];
        await sleep(",.!?¡¿".includes(last) ? 140 : 45);
      }
    }

    async function run() {
      const [first, ...rest] = messages;
      const loop = rest.length ? rest : [first];

      setState("typing");
      for (let i = 0; i < 3; i++) {
        spawnTap();
        await sleep(600);
      }
      await sleep(300);

      setState("surprised");
      await sleep(1000);
      setState("waving");

      bubbleGhost.textContent = first;
      bubbleText!.textContent = "";
      showBubble(true);
      await sleep(250);
      await typeText(first);
      await sleep(1500);
      showBubble(false);
      await sleep(100);

      while (root.isConnected) {
        for (const msg of loop) {
          bubbleGhost.textContent = msg;
          bubbleText!.textContent = "";
          showBubble(true);
          await sleep(250);
          await typeText(msg);
          await sleep(1500);
          showBubble(false);
          await sleep(100);
        }
      }
    }

    const imgs = [...root.querySelectorAll<HTMLImageElement>("img")];
    await Promise.all(imgs.map((img) => img.decode().catch(() => {})));

    run();
  }

  document
    .querySelectorAll<HTMLElement>("[data-avatar-greeting]")
    .forEach(init);
</script>
