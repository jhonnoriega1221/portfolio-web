---
import { Image } from "astro:assets";
import Card from "./ui/Card.astro";
import TitleCard from "./ui/TitleCard.astro";
import { Icon } from "astro-icon/components";

export interface Props {
  id: string;
  company: string;
  image?: ImageMetadata | string;
  period: string;
  description: string;
  role: string;
  class?: string;
}

const defaultImage =
  "https://p7.hiclipart.com/preview/812/515/745/white-square-symmetry-area-pattern-brown-frame-design-thumbnail.jpg";

const { id, company, image, period, description, role, class: className } = Astro.props;
---

<Card class:list={["bg-card p-4!", className]}>
  <div class="grid grid-cols-[46px_1fr] md:grid-cols-[100px_1fr] grid-rows-2 gap-x-3 gap-y-0 mb-4">
    <Image
    class="aspect-square row-span-1 md:row-span-2"
      alt=""
      height={108}
      width={108}
      src={(image as ImageMetadata) ?? defaultImage}
    />

    <TitleCard
      textClass="text-foreground! drop-shadow-none! text-xl!"
      class="bg-primary! py-1! px-2! mb-2 h-fit"
    >
      {company}
    </TitleCard>

    <div class="col-span-2 md:col-span-1">
      <p class="text-xl font-bold">{role}</p>
      <p class="flex gap-1 items-center">
        <Icon name="lucide:calendar" />
        {period}
      </p>
    </div>
  </div>
  <p class="text-lg">
    {description}
  </p>
</Card>
