---
import { Image } from "astro:assets";
import Card from "../ui/Card.astro";
import Section from "../ui/Section.astro";
import TitleCard from "../ui/TitleCard.astro";
import avatar from "../../assets/avatar/about.png";
import { categories, skills } from "../../data/skills";
import SkillSticker from "../SkillSticker.astro";
import SpeechBubble from "../ui/SpeechBubble.astro";

const grouped = categories.map((category) => ({
  ...category,
  items: skills.filter((skill) => skill.category === category.id),
}));
---

<Section id="about" wrapperClass="bg-tertiary pb-50">
  <TitleCard>Sobre mí</TitleCard>

  <div
    slot="background"
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
  >
    <div
      class="halftone-divider absolute inset-x-0 -bottom-20 h-100 bg-secondary"
    >
    </div>
  </div>

  <Card
    data-about
    class="relative mt-5 flex items-end gap-8 overflow-hidden bg-card-secondary md:gap-12 p-0! h-64 mb-12"
  >
    <SpeechBubble
      tail="responsive"
      class="text-2xl font-bold px-16 h-full lg:w-180 xl:w-240"
    >
      Soy un ingeniero front-end al que le apasiona crear interfaces accesibles,
      adaptables y de alto rendimiento. Disfruto transformando ideas en
      productos bien ejecutados y colaborando con personas excepcionales para
      hacer que las ideas se hagan realidad.
    </SpeechBubble>

    <Image
      src={avatar}
      alt="Jhon explicando con la mano extendida"
      widths={[160, 320, 480]}
      sizes="(min-width: 1024px) 16rem, 8rem"
      loading="lazy"
      decoding="async"
      class="relative -bottom-5 shrink-0 w-75 transform-[scaleX(-1)] mr-auto"
    />
  </Card>

  <div class="">
    <TitleCard class="bg-primary!">Mis skills</TitleCard>
    <div class="mt-8 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {
        grouped.map((category) => (
          <Card
            class="bg-canvas px-5! pt-5! pb-7!"
            as="article"
            aria-labelledby={`skills-${category.id}`}
          >
            <TitleCard
              class="p-0! mb-6 bg-transparent! border-none shadow-none"
              textClass="text-2xl!"
            >
              {" "}
              {category.title}
            </TitleCard>

            <ul class="flex flex-wrap gap-x-8 gap-y-8">
              {category.items.map((skill) => (
                <SkillSticker skill={skill} />
              ))}
            </ul>
          </Card>
        ))
      }
    </div>
  </div>
</Section>
