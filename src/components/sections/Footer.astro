---
import { Icon } from "astro-icon/components";
import ButtonIcon from "../ui/ButtonIcon.astro";
import Section from "../ui/Section.astro";
import TitleCard from "../ui/TitleCard.astro";
import HalftoneReveal from "../HalftoneReveal.astro";
---

<HalftoneReveal duration={1500} direction="top-to-bottom">
<Section class="flex flex-col lg:flex-row items-center h-auto pb-22! md:pb-8! justify-between gap-8">
  <div class="flex flex-col lg:flex-row items-center gap-10">
    <div>
      <h1
        class="font-extrabold text-primary drop-shadow-name-text text-[50px] lg:text-[38px] xl:text-[72px] mb-1"
      >
        Jhon Noriega
      </h1>
      <TitleCard class="p-1!" textClass="text-xl!">Front-end Engineer</TitleCard>
    </div>
    <div class="hidden lg:block h-22 border-l-3"></div>
    <p class="max-w-40 lg:max-w-full">Ideas, codigo y buenas experiencias en la web</p>
  </div>
  <ul class="flex gap-8">
    <li>
      <ButtonIcon as="a" href="/ola" label="GitHub">
        <Icon name="github" class="size-9 lg:size-8 xl:size-11" />
      </ButtonIcon>
    </li>
    <li>
      <ButtonIcon as="a" href="/ola" label="LinkedIn">
        <Icon name="linkedin" class="size-9 lg:size-8 xl:size-11" />
      </ButtonIcon>
    </li>
  </ul>
  <p>2026 • hecho por Jhon Noriega</p>
</Section>
</HalftoneReveal>