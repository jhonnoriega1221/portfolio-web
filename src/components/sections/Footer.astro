---
import { Icon } from "astro-icon/components";
import ButtonIcon from "../ui/ButtonIcon.astro";
import Section from "../ui/Section.astro";
import TitleCard from "../ui/TitleCard.astro";
---

<Section class="flex items-center h-[180px] justify-between items-center">
  <div class="flex items-center gap-10">
    <div>
      <h1
        class="font-extrabold text-primary drop-shadow-name-text lg:text-[38px] xl:text-[72px] mb-1"
      >
        Jhon Noriega
      </h1>
      <TitleCard class="p-1!" textClass="text-xl!">Front-end Engineer</TitleCard>
    </div>
    <div class="h-22 border-l-3"></div>
    <p>Ideas, codigo y buenas experiencias en la web</p>
  </div>
  <ul class="flex gap-8">
    <li>
      <ButtonIcon as="a" href="/ola" label="GitHub">
        <Icon name="github" class="size-9 lg:size-8 xl:size-11" />
      </ButtonIcon>
    </li>
    <li>
      <ButtonIcon as="a" href="/ola" label="LinkedIn">
        <Icon name="linkedin" class="size-9 lg:size-8 xl:size-11" />
      </ButtonIcon>
    </li>
  </ul>
  <p>2026 • hecho por Jhon Noriega</p>
</Section>
