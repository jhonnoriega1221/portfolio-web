---
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Section from "../ui/Section.astro";
import TitleCard from "../ui/TitleCard.astro";
import ButtonIcon from "../ui/ButtonIcon.astro";
import AvatarGreeting from "../AvatarGreeting.astro";
---

<Section
  id="hero"
  wrapperClass="pt-[calc(var(--navbar-height)+var(--navbar-spacing)*2+32px)] pb-50 bg-canvas"
>
  <div
    slot="background"
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10"
  >
    <div class="halftone absolute -top-90 -left-90 size-160 bg-foreground/20">
    </div>
    <div class="halftone absolute -top-100 -right-90 size-160 bg-primary"></div>

    <div
      class="halftone absolute -top-100 left-1/2 size-180 -translate-x-1/2 bg-foreground/20"
    >
    </div>

    <div class="halftone-divider absolute inset-x-0 -bottom-20 h-100 bg-tertiary">
    </div>
  </div>

  <div
    class="flex flex-col gap-10 lg:flex-row xl:gap-16 justify-between"
  >
    <div class="flex w-full xl:max-w-2xl lg:max-w-xl flex-col lg:gap-8 xl:gap-16">
      <header class="lg:px-7 xl:px-10">
        <h1
          class="font-extrabold text-primary drop-shadow-name-text lg:text-[64px] xl:text-[72px]"
        >
          Jhon Noriega
        </h1>
        <TitleCard>Front-end Engineer</TitleCard>

        <ul class="mt-5 flex gap-5">
          <li>
            <ButtonIcon as="a" href="/ola" label="GitHub">
              <Icon name="github" class="size-9 lg:size-10 xl:size-11" />
            </ButtonIcon>
          </li>
          <li>
            <ButtonIcon as="a" href="/ola" label="LinkedIn">
              <Icon name="linkedin" class="size-9 lg:size-10 xl:size-11" />
            </ButtonIcon>
          </li>
        </ul>
      </header>

      <Card class="relative overflow-hidden bg-card">
        <div
          aria-hidden="true"
          class="halftone absolute -top-60 -left-60 size-110 bg-foreground/5"
        >
        </div>
        <div
          aria-hidden="true"
          class="halftone absolute -right-50 -bottom-60 size-110 bg-foreground/5"
        >
        </div>

        <div class="relative">
          <p class="mb-8 text-[20px] xl:text-[24px] font-semibold">
            Soy un ingeniero de sistemas enfocado en el desarrollo front-end con
            +3 años de experiencia construyendo experiencias digitales
          </p>
          <div class="flex flex-wrap gap-4">
            <Button href="/proyectos">
              Ver proyectos
              <Icon name="lucide:arrow-right" class="size-7" />
            </Button>
            <Button class="bg-canvas!">
              Ver CV
              <Icon name="lucide:file-text" class="size-7" />
            </Button>
          </div>
        </div>
      </Card>
    </div>
    <AvatarGreeting class="w-full max-w-md lg:max-w-xl xl:max-w-3xl" />
  </div>
</Section>
