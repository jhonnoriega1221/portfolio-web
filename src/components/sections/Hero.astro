---
import { Icon } from "astro-icon/components";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Section from "../ui/Section.astro";
import TitleCard from "../ui/TitleCard.astro";
import ButtonIcon from "../ui/ButtonIcon.astro";
---

<Section id="hero" class="flex justify-between gap-9">
  <div class="w-full max-w-170 flex flex-col gap-12">
    <div class="px-7 py-15">
      <h1
        class="text-[4.5rem] font-extrabold drop-shadow-name-text text-primary"
      >
        Jhon Noriega
      </h1>
      <TitleCard> Front-end Engineer </TitleCard>
      <div class="flex gap-5 mt-5">
        <ButtonIcon as="a" href="/ola" label="GitHub Icon">
          <Icon name="github" class="size-11"/>
        </ButtonIcon>
        <ButtonIcon as="a" href="/ola" label="GitHub Icon">
          <Icon name="linkedin" class="size-11"/>
        </ButtonIcon>
      </div>
    </div>

    <Card class="bg-card">
      <p class="text-2xl font-semibold mb-8">
        Soy un ingeniero de sistemas enfocado en el desarrollo front-end con +3
        años de experiencia construyendo experiencias digitales
      </p>
      <div class="flex gap-4">
        <Button href="/dasds"
          >Ver proyectos
          <Icon name="lucide:arrow-right" class="size-7" />
        </Button>
        <Button class="bg-canvas!">
          Ver CV
          <Icon name="lucide:file-text" class="size-7" />
        </Button>
      </div>
    </Card>
  </div>

  <Card class="bg-primary w-full max-w-200 mt-12" />
</Section>
