---
import type { HTMLTag } from "astro/types";

interface Props {
  as?: HTMLTag;
  class?: string;
}

const { as: Tag = "div", class: className = "", ...rest } = Astro.props;
---

<Tag
  {...rest}
  class:list={[
    "border-6 border-card-border p-5 shadow-base lg:p-7 xl:p-10",
    className,
  ]}
>
  <slot />
</Tag>
