---
interface Props {
  id?: string;
  class?: string;
  wrapperClass?: string;
}

const { id, class: className = "", wrapperClass = "" } = Astro.props;
---

<section
  id={id}
  class:list={["relative isolate overflow-clip scroll-mt-20", wrapperClass]}
>
  <slot name="background" />

  <div class:list={["container-page", className]}>
    <slot />
  </div>
</section>
