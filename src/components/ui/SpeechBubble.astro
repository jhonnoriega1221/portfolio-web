---
interface Props {
  class?: string;
  /** "right": colita al costado. "responsive": colita abajo en móvil */
  tail?: "right" | "responsive";
}

const { class: className = "", tail = "right" } = Astro.props;
const responsive = tail === "responsive";
---

<div
  data-speech
  data-visible="true"
  class:list={[
    "relative rounded-full border-2 border-black bg-white px-5 py-4 shadow-sm",
    "transition-scale duration-200",
    "data-[visible=false]:scale-50 motion-reduce:transition-none",
    responsive ? "origin-bottom-right md:origin-right" : "origin-right",
    className,
  ]}
>
  <p data-speech-text class="lg:font-bold font-semibold leading-[1.2] lg:leading-[1.4]"><slot /></p>

  {
    responsive && (
      <svg
        aria-hidden="true"
        viewBox="0 0 40 40"
        class="pointer-events-none absolute top-full right-27.5 h-auto w-8 overflow-visible md:hidden"
      >
        <path
          d="M4 0 C6 16 20 28 38 34 C28 26 18 14 16 0"
          fill="white"
          stroke="black"
          stroke-width="2"
          stroke-linejoin="round"
          vector-effect="non-scaling-stroke"
        />
      </svg>
    )
  }

  <svg
    aria-hidden="true"
    viewBox="0 0 40 40"
    class:list={[
      "pointer-events-none absolute top-[20%] left-[calc(100%-20px)] h-auto w-6 overflow-visible md:w-10 xl:w-12",
      responsive && "hidden md:block",
    ]}
  >
    <path
      d="M0 4 C12 6 28 16 40 30 C26 26 12 26 0 24"
      fill="white"
      stroke="black"
      stroke-width="2"
      stroke-linejoin="round"
      vector-effect="non-scaling-stroke"></path>
  </svg>
</div>

<script>
  const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

  function init(root: HTMLElement) {
    const p = root.querySelector<HTMLElement>("[data-speech-text]")!;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const chars = [...(p.textContent ?? "").replace(/\s+/g, " ").trim()];

    const typed = document.createElement("span");
    const rest = document.createElement("span");
    rest.className = "text-transparent";
    rest.textContent = chars.join("");
    p.replaceChildren(typed, rest);

    root.dataset.visible = "false";

    async function play() {
      root.dataset.visible = "true";
      await sleep(450);
      for (let i = 1; i <= chars.length; i++) {
        typed.textContent = chars.slice(0, i).join("");
        rest.textContent = chars.slice(i).join("");
        await sleep(",.!?".includes(chars[i - 1]) ? 120 : 30);
      }
    }

    new IntersectionObserver(
      ([entry], obs) => {
        if (!entry.isIntersecting) return;
        obs.disconnect();
        play();
      },
      { rootMargin: "0px 0px -20% 0px" },
    ).observe(root);
  }

  document.querySelectorAll<HTMLElement>("[data-speech]").forEach(init);
</script>
