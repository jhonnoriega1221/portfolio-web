---
interface Props {
  class?: string;
  textClass?: string;
}

const { class: className = "", textClass, ...rest } = Astro.props;
---

<div
  class:list={[
    "px-3 bg-secondary w-fit xl:py-3 lg:py-2 py-1 border-3 shadow-base",
    className,
  ]}
  {...rest}
>
  <h2
    class:list={[
      "text-2xl xl:text-4xl lg:text-2xl font-bold text-white drop-shadow-title-text",
      textClass,
    ]}
  >
    <slot />
    </h2>
</div>
