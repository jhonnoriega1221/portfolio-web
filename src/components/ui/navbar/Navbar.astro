---
import Card from "../../ui/Card.astro";
import WindowReveal from "../../WindowReveal.astro";
import NavbarItem from "./NavbarItem.astro";
---

<Card
as="nav"
class="fixed w-full border-none shadow-none p-0! h-fit flex justify-center bottom-[calc(var(--navbar-spacing-mobile)+env(safe-area-inset-bottom)+var(--navbar-height-mobile))] md:top-(--navbar-spacing) z-1"
>
<WindowReveal duration={800} immediate origin="center" class="border-3! fixed mx-auto w-fit h-(--navbar-height-mobile)  md:h-(--navbar-height-desktop) md:px-4! md:py-3 bg-card shadow-base flex gap-1 md:gap-3 items-center">

    <NavbarItem href="#" label="Inicio" icon="solar:home-2" />
    <NavbarItem href="#about" label="Sobre mí" icon="solar:user" />
    <NavbarItem href="#projects" label="Proyectos" icon="solar:code" />
    <NavbarItem href="#experience" label="Experiencia" icon="solar:suitcase" />
    <NavbarItem href="#contact" label="Contacto" icon="solar:chat-round" />

</WindowReveal>
</Card>