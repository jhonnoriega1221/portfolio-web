---
import { Icon } from "astro-icon/components";
import HalftoneReveal from "../../HalftoneReveal.astro";

interface Props {
  href: string;
  label: string;
  icon: string;
}

const { href, label, icon } = Astro.props;
---

<HalftoneReveal duration={1000} delay={400} direction="bottom-to-top">
  <a
    href={href}
    data-nav-link
    class="group flex flex-col md:flex-row gap-0.5 md:gap-2.5 max-w-16 md:max-w-full w-16 md:w-full h-12 md:h-11 items-center justify-center md:justify-start px-1 md:px-3.5 border-2 border-transparent text-muted-foreground hover:text-foreground hover:bg-tertiary hover:border-card-border active:animate-squish data-[active=true]:bg-secondary data-[active=true]:text-white data-[active=true]:border-card-border lg:data-[active=true]:shadow-sm transition-all text-nowrap"
  >
    <Icon
      name={`${icon}-broken`}
      class="size-5 md:size-6 block group-data-[active=true]:hidden"
    />
    <Icon
      name={`${icon}-bold`}
      class="size-5 md:size-6 hidden group-data-[active=true]:block"
    />
    <span class="text-[11px] md:text-base font-extrabold leading-none">
      {label}
    </span>
  </a>
</HalftoneReveal>